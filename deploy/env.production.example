APP_NAME=ElevenRank
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://elevenrank.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Mail goes to the log until a mailbox is set up in cPanel.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@elevenrank.com"
MAIL_FROM_NAME="${APP_NAME}"
